{
  "id": "camofox-browser",
  "name": "Camofox Browser",
  "version": "1.6.0",
  "newPageTimeoutMs": 10000,
  "interactive": { "mode": "off" },
  "plugins": {
    "youtube": {
      "enabled": true
    },
    "persistence": {
      "enabled": true
    },
    "persistence-interval": {
      "enabled": true,
      "intervalMs": 300000
    },
    "vnc": {
      "enabled": true,
      "resolution": "1920x1080",
      "vncPort": 5900,
      "novncPort": 6080,
      "viewOnly": false
    },
    "wslg-display": {
      "enabled": true,
      "claimDisplay": false
    }
  }
}
